window.Servlet = {"name":"reader","server":"./","folder":"./reader/static","version":"3001.29.0.250428.154919","birthday":"3001.250430.1.0-250428.154919"};
var param = {"file":"https://www.moa.gov.cn/govpublic/SYJ/201511/P020151125628261658854.ceb","wr_hash":"639ced4ada4cff893c58ef3bdaf0de82204f78ee"};
